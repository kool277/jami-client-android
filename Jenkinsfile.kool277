// kool277 pipeline for kool277/jami-client-android (multibranch job from
// ci/jenkins/setup.sh in kool277/jami). The build scripts live in the
// workspace repository kool277/jami: each build fetches it (outside the
// checkout, into $WORKSPACE_TMP/kool277) for a v* release tag at the
// platform release named in the tag message, else main. Builds reuse the
// daemon's contrib tree and the app's build/ of the previous build in this
// Jenkins workspace; the first one takes hours.
//
// The app builds against its daemon submodule; on a v* tag against the
// jami-daemon commit that the workspace pins, the one the platform release
// ships. Every build: the build image from the app's docker/Dockerfile,
// release APKs for every ABI and flavor (unsigned, as upstream builds
// them) and the libjamiclient unit tests, in the ci/android container. On
// a v* tag: sign the APKs with the release keystore and publish them to
// the GitHub release (see RELEASING.md in kool277/jami). Needs the
// github-kool277 and android-keystore* credentials, docker and
// /var/cache/jami on the agent.

// The kool277/jami ref to build with: for a v* release tag, the platform
// release that made it, from the "Platform:" line of the tag message (see
// ci/release/platform-release.sh in kool277/jami); else main. Call it after
// the checkout.
def ciRef() {
    if (!env.TAG_NAME?.startsWith('v')) {
        return 'main'
    }
    def platform = sh(returnStdout: true,
                      script: 'git for-each-ref --format="%(contents)" "refs/tags/$TAG_NAME" | sed -n "s/^Platform: //p"').trim()
    if (!platform) {
        error("The message of tag ${env.TAG_NAME} names no platform release (no Platform: line)")
    }
    return platform
}

// Run a network step up to 10 times, 30 s apart: this agent's connection
// drops for minutes at a time.
def withNetRetry(Closure body) {
    def attempt = 0
    retry(10) {
        if (attempt++ > 0) {
            sleep(time: 30, unit: 'SECONDS')
        }
        body()
    }
}

pipeline {
    agent any
    options {
        timestamps()
        ansiColor('xterm')
        timeout(time: 8, unit: 'HOURS')
        disableConcurrentBuilds()
        // Checked out in the first stage, with withNetRetry.
        skipDefaultCheckout()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    environment {
        KOOL277 = "${env.WORKSPACE_TMP}/kool277"
        CI = "${env.WORKSPACE_TMP}/kool277/ci"
        ANDROID_DIR = "${env.WORKSPACE}"
        DAEMON_DIR = "${env.WORKSPACE}/daemon"
    }
    stages {
        stage('Sources') {
            steps {
                withNetRetry {
                    checkout scm
                }
                script {
                    env.CI_REF = ciRef()
                }
                withNetRetry {
                    sh 'rm -rf "$KOOL277" && git clone -q --depth 1 --branch "$CI_REF" https://github.com/kool277/jami.git "$KOOL277"'
                }
                // --force: an update cut short by an outage leaves the
                // submodule cloned but not checked out, at the pinned
                // commit, so a plain update would skip it from then on.
                withNetRetry {
                    sh 'git submodule update --init --force daemon'
                }
                script {
                    if (env.TAG_NAME?.startsWith('v')) {
                        def pin = sh(returnStdout: true,
                                     script: "git -C \"\$KOOL277\" ls-tree HEAD jami-daemon | awk '{print \$3}'").trim()
                        withNetRetry {
                            sh "git -C daemon fetch -q origin ${pin} && git -C daemon checkout -q ${pin}"
                        }
                    }
                }
                sh 'git -C daemon log --oneline -1'
            }
        }
        stage('Image') {
            steps {
                // The image downloads the SDK, NDK and toolchains.
                withNetRetry {
                    sh '"$CI/android/run.sh" true'
                }
            }
        }
        stage('Build') {
            steps {
                sh 'SKIP_IMAGE_BUILD=1 "$CI/android/run.sh"'
            }
        }
        stage('Test') {
            steps {
                sh 'SKIP_IMAGE_BUILD=1 "$CI/android/run.sh" sh /ci/test.sh'
            }
            post {
                always { junit allowEmptyResults: true, testResults: 'jami-android/libjamiclient/build/test-results/test/*.xml' }
            }
        }
        stage('Release') {
            when { tag 'v*' }
            steps {
                // Signed with the release keystore held by the Jenkins
                // credentials android-keystore (secret file) and
                // android-keystore-password, android-key-alias and
                // android-key-password (secret texts); see RELEASING.md in
                // kool277/jami. The keystore is mounted read-only into the
                // build container; the passwords go through the environment
                // only (the shell expands them, not Groovy, so they never
                // reach the build log).
                withCredentials([file(credentialsId: 'android-keystore', variable: 'ANDROID_KEYSTORE_FILE'),
                                 string(credentialsId: 'android-keystore-password', variable: 'ANDROID_KEYSTORE_PASSWORD'),
                                 string(credentialsId: 'android-key-alias', variable: 'ANDROID_KEY_ALIAS'),
                                 string(credentialsId: 'android-key-password', variable: 'ANDROID_KEY_PASSWORD')]) {
                    sh '''VERSION="$TAG_NAME" ANDROID_KEYSTORE=/run/keystore.jks \\
DOCKER_RUN_ARGS="-e VERSION -e ANDROID_KEYSTORE -e ANDROID_KEYSTORE_PASSWORD -e ANDROID_KEY_ALIAS -e ANDROID_KEY_PASSWORD -v $ANDROID_KEYSTORE_FILE:/run/keystore.jks:ro" \\
SKIP_IMAGE_BUILD=1 "$CI/android/run.sh" sh /ci/package.sh'''
                }
                archiveArtifacts artifacts: 'jami-android/app/build/dist/*', fingerprint: true
                withCredentials([usernamePassword(credentialsId: 'github-kool277',
                                                  usernameVariable: 'GH_USER',
                                                  passwordVariable: 'GH_TOKEN')]) {
                    withNetRetry {
                        sh 'PLATFORM="$CI_REF" "$CI/release/publish-release.sh" jami-client-android "$TAG_NAME" jami-android/app/build/dist/*'
                    }
                }
            }
        }
    }
    post {
        // A v* tag is built once, for a release: free its workspace,
        // several GB with the contrib build, when the build ends. Branch
        // and pull request builds keep theirs to build incrementally.
        cleanup {
            script {
                if (env.TAG_NAME?.startsWith('v')) {
                    cleanWs(notFailBuild: true)
                }
            }
        }
    }
}
